# Auth.js v5 + GitHub OAuth — 관리자 콘솔(/contentmanagement) 인증용.
# 실제 값은 .env.local(로컬) / Vercel 환경변수(배포)에 넣는다. 이 파일은 키 목록만.

# Auth.js 세션 암호화 키. 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=

# GitHub OAuth App 의 Client ID / Client Secret.
# GitHub → Settings → Developer settings → OAuth Apps 에서 발급.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 접근을 허용할 GitHub 계정명(login) 쉼표 구분 목록.
# 저장소 소유자(halfjinhyeon)는 코드에서 항상 허용되므로 여기 없어도 된다.
# 예: ALLOWED_GITHUB_LOGINS=alice,bob
ALLOWED_GITHUB_LOGINS=

# (선택, 개발 전용) 로컬 dev 서버에서 GitHub 로그인 없이 /contentmanagement 를
# 열어볼 수 있게 하는 우회 토큰. 프로덕션 빌드(NODE_ENV=production)에서는 무시된다.
# 실제로 GitHub API 커밋까지 테스트하려면 여기에 GitHub PAT(repo scope)을 넣는다.
# 비워두면 콘솔 UI는 뜨지만 목록 조회/저장은 401로 실패한다(레이아웃 확인용으로는 충분).
DEV_GITHUB_TOKEN=
